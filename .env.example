# commit this - shows required vars without values
PORT=3001
MONGO_URI=mongodb://localhost:27017/UchiNihon
JWT_SECRET=your-secret-here || optional-fallback-here
# Add additional origins as needed, comma separated
CORS_ORIGIN=http://localhost:3001, http://localhost:4173

# e-Stat (Japan government statistics API) — https://www.e-stat.go.jp/
# Register a free Application ID at https://www.e-stat.go.jp/mypage/ (one per app, not per user).
ESTAT_APP_ID=
# Optional: default statsDataId used by `npm run estat:sync` / POST /api/estat/sync.
# Find one with `npm run estat:search -- "空き家"` (see ESTAT_INTEGRATION.md).
ESTAT_STATS_DATA_ID=
